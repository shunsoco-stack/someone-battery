# Copy to .env.local. Only public Firebase WEB application configuration belongs here.
# Never put service-account JSON, private keys, admin credentials, or access tokens here.
# All four blank => visibly labeled demo. Partial configuration => explicit error.
# All four configured => real Firebase ONLY; errors never fall back to fake posts.
# NEXT_PUBLIC_ values are baked into the browser bundle at build time: redeploy after changes.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional canonical public URL for metadata/sharing. Not an authentication secret.
NEXT_PUBLIC_SITE_URL=

# Vercel Web Analytics custom events require Pro or Enterprise.
# Enable Web Analytics in that project's dashboard first, then set true and redeploy.
# Defaults to false: Hobby deployments do not send events that cannot be collected.
# Only action/mode counts, fixed anonymous IP/user-agent, no names/percentages/IDs.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
